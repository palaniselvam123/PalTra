# Fernet key for encrypting broker credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# SQLite database path
DATABASE_URL=sqlite+aiosqlite:///./trading.db

# App mode: paper | live (paper is the only safe default; live requires explicit opt-in in the UI too)
DEFAULT_MODE=paper

# CORS origin for the Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000

# Account capital used by the risk engine's 1% position sizer (INR)
ACCOUNT_CAPITAL=100000

# --- Course coach (RAG over your uploaded trading curriculum) ---
# Advisory only: explains patterns using your own course PDFs. It has no veto
# and no path to the order engine; if unreachable, trading is unaffected.
COURSE_RAG_ENABLED=true
COURSE_RAG_URL=http://localhost:3001
COURSE_RAG_API_KEY=

# MCP server at /mcp for n8n, Gemini, Claude etc. Off when empty. Use 24+ random
# characters (python -c "import secrets;print(secrets.token_urlsafe(32))") and set it
# on Fly with `fly secrets set MCP_TOKEN=...`. Changes only reach PAPER bots.
MCP_TOKEN=

# --- Scanner server (SCANNER.md) ---
# PALTRA_ROLE=scanner makes this server scan-only: it never sends an order and refuses LIVE.
PALTRA_ROLE=
# SCANS=off on the desk turns its own Scalp scans off (they run on the scanner server).
SCANS=
# Where each server finds the other. DESK_URL defaults to https://paltra.fly.dev.
DESK_URL=
SCANNER_URL=
# Read-only link (armed stocks only), the same 24+ random characters on both servers.
SCANNER_LINK_TOKEN=
